# Copy to .env.local, fill locally, and keep it out of Git. Do not paste secrets in chat.
# Spring Boot does NOT load this file automatically; scripts/run-local.ps1 loads allowed entries.
JAVA_HOME=C:\Program Files\Java\jdk-21.0.5
DB_URL=jdbc:postgresql://localhost:5432/habit_coach
DB_USERNAME=habit
DB_PASSWORD=replace-locally
PORT=8081
COACH_INTERNAL_API_KEY=replace-with-a-long-random-secret
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Enable only after choosing models/cost controls and accepting provider processing.
COACH_AI_ENABLED=false
COACH_AI_APIKEY=
COACH_AI_TEXTMODEL=
COACH_AI_SPEECHMODEL=
COACH_AI_TRANSCRIPTIONMODEL=
COACH_AI_VOICE=
COACH_AI_FFMPEGEXECUTABLE=ffmpeg
